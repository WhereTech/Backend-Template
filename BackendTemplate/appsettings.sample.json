{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=/tmp/backend-template.db",
    "PoolSize": 20
  },
  "Auth": {
    "SmsCodeExpireMinutes": 10,
    "SessionExpireDays": 7
  },
  //#if (FileStorage)
  "FileStorage": {
    "Endpoint": "https://s3.example.com",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "app-files"
  },
  //#endif
  //#if (SMS)
  "SMS": {
    "AccessKeyId": "",
    "AccessKeySecret": "",
    "SignName": "",
    "SdkRegion": "cn-hangzhou",
    "TemplateCode": {
      "VerifyCode": ""
    }
  },
  //#endif
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "RequestLogging": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Warning",
      "BackendTemplate.Schedule.Jobs": "Information"
    },
    "Console": {
      "FormatterOptions": {
        "SingleLine": false,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  },
  "Server": {
    "Host": "http://0.0.0.0:8080",
    "MaxConcurrency": 20,
    "WaitTimeoutSeconds": 30
  },
  "AllowedHosts": "*"
}
